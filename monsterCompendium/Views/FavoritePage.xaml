<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="monsterCompendium.Views.FavoritePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:monsterCompendium.Models"
    xmlns:viewmodels="clr-namespace:monsterCompendium.ViewModels"
    x:DataType="viewmodels:FavoritesViewModel"
    Title="Favoritos">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="15">

        <!-- Título -->
        <Label
            Grid.Row="0"
            Text="Monstruos favoritos"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center" />

        <!-- Estado -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding StatusMessage}"
                FontSize="14"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <!-- Lista -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Favorites}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:FavoriteItem">

                    <Border
                        Margin="0,5"
                        Padding="10"
                        StrokeThickness="1">

                        <Grid
                            RowDefinitions="Auto,Auto"
                            RowSpacing="10">

                            <!-- Información principal -->
                            <Grid
                                Grid.Row="0"
                                ColumnDefinitions="80,*,Auto"
                                ColumnSpacing="15">

                                <!-- Imagen original de la API -->
                                <Image
                                    Grid.Column="0"
                                    Source="{Binding Monster.ImageUrl}"
                                    HeightRequest="70"
                                    WidthRequest="70"
                                    Aspect="AspectFit"
                                    VerticalOptions="Center">

                                    <Image.GestureRecognizers>

                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesViewModel}},
                                                              Path=SelectMonsterCommand}"
                                            CommandParameter="{Binding .}" />

                                    </Image.GestureRecognizers>

                                </Image>

                                <!-- Información -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="5">

                                    <Label
                                        Text="{Binding Monster.Name}"
                                        FontSize="18"
                                        FontAttributes="Bold">

                                        <Label.GestureRecognizers>

                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesViewModel}},
                                                                  Path=SelectMonsterCommand}"
                                                CommandParameter="{Binding .}" />

                                        </Label.GestureRecognizers>

                                    </Label>

                                    <HorizontalStackLayout
                                        Spacing="5">

                                        <Label
                                            Text="{Binding Monster.Type}"
                                            FontSize="14" />

                                        <Label
                                            Text="•"
                                            FontSize="14" />

                                        <Label
                                            Text="{Binding Monster.Size}"
                                            FontSize="14" />

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                                <!-- Eliminar favorito -->
                                <Button
                                    Grid.Column="2"
                                    Text="Eliminar"
                                    VerticalOptions="Center"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesViewModel}},
                                                      Path=RemoveFavoriteCommand}"
                                    CommandParameter="{Binding .}" />

                            </Grid>

                            <!-- Foto local + cámara -->
                            <Grid
                                Grid.Row="1"
                                ColumnDefinitions="120,*"
                                ColumnSpacing="15">

                                <!-- Foto tomada por el usuario -->
                                <Border
                                    Grid.Column="0"
                                    HeightRequest="110"
                                    WidthRequest="110"
                                    Padding="2"
                                    StrokeThickness="1">

                                    <Image
                                        Source="{Binding PhotoPath}"
                                        Aspect="AspectFill"
                                        HeightRequest="105"
                                        WidthRequest="105" />

                                </Border>

                                <!-- Acción de cámara -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    Spacing="8">

                                    <Label
                                        Text="Foto del favorito"
                                        FontAttributes="Bold"
                                        FontSize="14" />

                                    <Button
                                        Text="Agregar / Reemplazar foto"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesViewModel}},
                                                          Path=AddPhotoCommand}"
                                        CommandParameter="{Binding .}" />

                                </VerticalStackLayout>

                            </Grid>

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>