<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="monsterCompendium.Views.FavoritePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:monsterCompendium.Models"
    xmlns:viewmodels="clr-namespace:monsterCompendium.ViewModels"
    x:DataType="viewmodels:FavoritesViewModel"
    Title="Favoritos">

    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="15">

        <!-- Título -->
        <Label
            Grid.Row="0"
            Text="Monstruos favoritos"
            FontSize="24"
            FontAttributes="Bold"
            HorizontalTextAlignment="Center" />

        <!-- Estado de carga -->
        <VerticalStackLayout
            Grid.Row="1"
            Spacing="5">

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Label
                Text="{Binding StatusMessage}"
                FontSize="14"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <!-- Lista de favoritos -->
        <CollectionView
            Grid.Row="2"
            ItemsSource="{Binding Favorites}"
            SelectionMode="None">

            <CollectionView.ItemTemplate>

                <DataTemplate x:DataType="models:Monster">

                    <Border
                        Margin="0,5"
                        Padding="10"
                        StrokeThickness="1">

                        <!-- Tocar la tarjeta abre el detalle -->
                        <Border.GestureRecognizers>

                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesViewModel}},
                                                  Path=SelectMonsterCommand}"
                                CommandParameter="{Binding .}" />

                        </Border.GestureRecognizers>

                        <Grid
                            ColumnDefinitions="80,*,Auto"
                            ColumnSpacing="15">

                            <!-- Imagen -->
                            <Image
                                Grid.Column="0"
                                Source="{Binding ImageUrl}"
                                HeightRequest="70"
                                WidthRequest="70"
                                Aspect="AspectFit"
                                VerticalOptions="Center" />

                            <!-- Información -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                VerticalOptions="Center"
                                Spacing="5">

                                <Label
                                    Text="{Binding Name}"
                                    FontSize="18"
                                    FontAttributes="Bold" />

                                <HorizontalStackLayout
                                    Spacing="5">

                                    <Label
                                        Text="{Binding Type}"
                                        FontSize="14" />

                                    <Label
                                        Text="•"
                                        FontSize="14" />

                                    <Label
                                        Text="{Binding Size}"
                                        FontSize="14" />

                                </HorizontalStackLayout>

                            </VerticalStackLayout>

                            <!-- Eliminar favorito -->
                            <Button
                                Grid.Column="2"
                                Text="Eliminar"
                                VerticalOptions="Center"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesViewModel}},
                                                  Path=RemoveFavoriteCommand}"
                                CommandParameter="{Binding .}" />

                        </Grid>

                    </Border>

                </DataTemplate>

            </CollectionView.ItemTemplate>

        </CollectionView>

    </Grid>

</ContentPage>