<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="monsterCompendium.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:monsterCompendium"
    xmlns:views="clr-namespace:monsterCompendium.Views"
    Title="monsterCompendium">

    <TabBar>

        <!-- Lista general de monstruos -->
        <ShellContent
            Title="Monstruos"
            Route="monsters"
            ContentTemplate="{DataTemplate views:MonsterPage}" />

        <!-- Monstruos favoritos -->
        <ShellContent
            Title="Favoritos"
            Route="favorites"
            ContentTemplate="{DataTemplate views:FavoritePage}" />

    </TabBar>

</Shell>
